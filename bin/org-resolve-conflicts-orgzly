#!/bin/bash
set -Eeuo pipefail

ORG_DIR="${HOME}/Dropbox/org"

usage() {
  echo "Usage: $(basename "$0") [FILE]"
  echo
  echo "Resolve an Orgzly sync conflict for FILE in ${ORG_DIR}."
  echo "FILE may be a name (work), a filename (work.org), or a path."
  echo "Default: home.org"
}

# Parse arguments
if [ $# -gt 1 ]; then
  usage
  exit 1
fi
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
TODO_NAME="${1:-home.org}"

# Resolve FILE to a path: as given if it exists, else inside ORG_DIR,
# adding a .org extension if missing
if [ -e "$TODO_NAME" ]; then
  TODO_PATH="$TODO_NAME"
else
  TODO_NAME="$(basename "$TODO_NAME")"
  [[ "$TODO_NAME" == *.* ]] || TODO_NAME="${TODO_NAME}.org"
  TODO_PATH="${ORG_DIR}/${TODO_NAME}"
fi
if [ ! -e "$TODO_PATH" ]; then
  echo "Error: file not found: ${TODO_PATH}"
  exit 1
fi
TODO_BAK="${TODO_PATH}.bak"

# Sanity Check
if [ -e "$TODO_BAK" ]; then
  echo "Error: backup file already exists: ${TODO_BAK}"
  exit 1
fi

# Move conflicted file out of the way
set -x
mv -v "$TODO_PATH" "$TODO_BAK"
{ set +x; } 2>/dev/null

# On Ctrl-C while waiting, restore the backup unless Orgzly's copy has
# already arrived, which we must not clobber
restore() {
  trap - INT
  echo
  if [ -e "$TODO_PATH" ]; then
    echo "Not restoring: ${TODO_PATH} exists.  Backup kept: ${TODO_BAK}"
  else
    mv -nv "$TODO_BAK" "$TODO_PATH"
  fi
  exit 130
}
trap restore INT

# Wait for Orgzly to push its copy back through Dropbox
echo "Sync Orgzly now.  Waiting for ${TODO_PATH} ...  Ctrl-C to abort."
while [ ! -e "$TODO_PATH" ]; do
  sleep 1
done
trap - INT

# Merge
set -x
ediff "$TODO_BAK" "$TODO_PATH"
{ set +x; } 2>/dev/null

# Prompt user to delete conflict files
read -e -p "Delete '${TODO_BAK}' ? " choice
if [[ "$choice" != [Yy]* ]]; then
  exit 0
fi
set -x
rm "$TODO_BAK"
{ set +x; } 2>/dev/null

#!/usr/bin/env bash

# Stop on errors
set -Eeuo pipefail

# Copy output to log file
mkdir -p ${HOME}/.local/var/log/upgrade
LOGFILE=${HOME}/.local/var/log/upgrade/upgrade-$(date '+%Y-%m-%d_%H%M').log
echo "Logging to ${LOGFILE}"
exec > >(tee -a ${LOGFILE}); exec 2>&1;
echo "$0"
date

# Cache sudo permissions
sudo -v

# Print commands
set -x

# Update Emacs packages.
#
# --batch skips early-init.el, so activate packages explicitly.  Initialize
# with quickstart off so package.el scans elpa/ instead of trusting a possibly
# stale package-quickstart.el, then turn quickstart on so installs regenerate
# it.  See package notes in init.el.
command emacs --batch \
  --eval='
    (progn
      (package-initialize)
      (setq package-quickstart t))' \
  --load ${HOME}/.emacs.d/init.el \
  --eval='
    (progn
      (package-refresh-contents)
      (package-vc-upgrade-all)
      (package-upgrade-all)
      (message "Packages updated successfully."))'

# Update Python packages
pipx upgrade-all

# Update Ruby packages
gem update --system --quiet
gem cleanup --silent

# Update npm packages in ~/.local
npm --prefix ${HOME}/.local update

# Update Homebrew packages
brew update --quiet
brew upgrade --quiet --greedy || true
brew cleanup --quiet

# Update macOS packages
softwareupdate --install --all

# Finished
set +x
echo "$0 success"

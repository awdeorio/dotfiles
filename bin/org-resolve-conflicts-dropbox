#!/bin/bash
set -Eeuo pipefail

# Find Dropbox conflicted copies of any org file, e.g.,
# "home (Andrew DeOrio's conflicted copy 2026-10-27).org"
CONFLICT_FILES=()
while IFS= read -r -d '' CONFLICT_FILE; do
  CONFLICT_FILES+=("$CONFLICT_FILE")
done < <(gfind "${HOME}/Dropbox/org" -name '*conflicted copy*.org' -print0 | sort -z)

# Exit if no conflicted copies
if [ ${#CONFLICT_FILES[@]} -eq 0 ]; then
  echo "No conflicted files"
  exit 0
fi

# Diff each conflict file against the original it was copied from
for CONFLICT_FILE in "${CONFLICT_FILES[@]}"; do
  MERGED_FILE=$(echo "$CONFLICT_FILE" | sed -E 's/ \([^)]*conflicted copy[^)]*\)//')
  if [ ! -e "$MERGED_FILE" ]; then
    echo "Error: original file not found: ${MERGED_FILE}"
    exit 1
  fi
  set -x
  ediff "$CONFLICT_FILE" "$MERGED_FILE"
  { set +x; } 2>/dev/null
done

# Prompt user to delete conflict files
read -e -p "Delete conflicted files? " choice
if [[ "$choice" != [Yy]* ]]; then
  exit 0
fi
for CONFLICT_FILE in "${CONFLICT_FILES[@]}"; do
  set -x
  rm "$CONFLICT_FILE"
  { set +x; } 2>/dev/null
done

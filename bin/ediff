#!/bin/bash
#
# Start emacs in ediff-mode, full height, double width
#
# Width 163 is two 80-column panes plus 3 columns for fringes and the divider.
# -g requires a height, so 999 lines is a placeholder taller than any screen (a
# 5K display fits about 200).  fullheight then fits the frame to the screen.

set -e
emacs \
  -g 163x999 \
  --eval "(set-frame-parameter nil 'fullscreen 'fullheight)" \
  --eval "(ediff-files \"$1\" \"$2\")"

#!/bin/bash
set -Eeuo pipefail

BRAVE="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
PROFILE_DIR="${TMPDIR%/}/brave-scratch"

usage() {
  echo "Usage: $(basename "$0") [URL ...]"
  echo
  echo "Start a throwaway Brave instance with an empty profile."
  echo "If one is already running, open URLs in it instead."
}

# Parse arguments
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

# Sanity check
if [ ! -x "$BRAVE" ]; then
  echo "Error: Brave not found: ${BRAVE}"
  exit 1
fi

# Already running: hand URLs to the existing instance
if pgrep -f -- "--user-data-dir=${PROFILE_DIR}( |$)" > /dev/null; then
  "$BRAVE" --user-data-dir="$PROFILE_DIR" "$@" &> /dev/null
  exit 0
fi

# Start fresh in the background.  Delete the profile on any exit.  On a
# signal, quit Brave first so the profile isn't deleted while in use.
rm -rf "$PROFILE_DIR"
mkdir -p "$PROFILE_DIR"

# Disable product analytics and usage pings, and suppress the analytics
# notice infobar
cat > "${PROFILE_DIR}/Local State" <<'EOF'
{
  "brave": {
    "p3a": {"enabled": false, "notice_acknowledged": true},
    "stats": {"reporting_enabled": false}
  }
}
EOF

# Declutter the UI.  Hide the empty bookmarks bar and its "Import bookmarks"
# button.  On the new tab page, hide the cards (including VPN "Start free
# trial"), stats, news, "Ask anything" search box, and background photo.  Hide
# the VPN and Rewards buttons.  Hide Leo AI in the toolbar, address bar,
# context menu, and tab menu.  Hide Brave Wallet and don't expose it to web
# pages (1 = DefaultWallet::None).
mkdir -p "${PROFILE_DIR}/Default"
cat > "${PROFILE_DIR}/Default/Preferences" <<'EOF'
{
  "bookmark_bar": {"show_on_all_tabs": false},
  "brave": {
    "ai_chat": {
      "autocomplete_provider_enabled": false,
      "context_menu_enabled": false,
      "show_toolbar_button": false,
      "tab_organization_enabled": false
    },
    "always_show_bookmark_bar_on_ntp": false,
    "brave_search": {"show-ntp-chat": false, "show-ntp-search": false},
    "brave_vpn": {"show_button": false},
    "new_tab_page": {
      "hide_all_widgets": true,
      "show_background_image": false,
      "show_branded_background_image": false,
      "show_brave_news": false,
      "show_brave_vpn": false,
      "show_rewards": false,
      "show_stats": false,
      "show_together": false
    },
    "rewards": {"show_brave_rewards_button_in_location_bar": false},
    "show_brave_rewards_button": false,
    "wallet": {
      "default_cardano_wallet": 1,
      "default_solana_wallet": 1,
      "default_wallet2": 1,
      "nft_discovery_enabled": false,
      "should_show_wallet_suggestion_badge": false,
      "show_wallet_icon_on_toolbar": false
    }
  }
}
EOF

(
  PID=""
  quit_brave() {
    if [ -n "$PID" ]; then
      kill "$PID" 2> /dev/null || true
      wait "$PID" || true
    fi
    exit 143
  }
  trap 'rm -rf "$PROFILE_DIR"' EXIT
  trap quit_brave TERM HUP INT

  # Run Brave in the background so that a signal can interrupt wait and
  # run the trap right away
  "$BRAVE" --no-first-run --no-default-browser-check \
    --user-data-dir="$PROFILE_DIR" "$@" &
  PID=$!
  wait "$PID" || true
) &> /dev/null &
disown
